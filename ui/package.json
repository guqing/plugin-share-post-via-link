{
  "type": "module",
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "dev": "vite build --watch --mode=development",
    "lint": "run-s \"lint:*\"",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write src/"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ],
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none"
  },
  "dependencies": {
    "@halo-dev/api-client": "^2.27.0",
    "@halo-dev/components": "^2.27.0",
    "@halo-dev/ui-shared": "^2.27.0",
    "@tanstack/vue-query": "4",
    "@vueuse/core": "^10.11.1",
    "axios": "1.16.1",
    "dayjs": "^1.11.13",
    "es-toolkit": "^1.53.0",
    "vue": "^3.5.40",
    "vue-router": "~5.1.0"
  },
  "devDependencies": {
    "@halo-dev/ui-plugin-bundler-kit": "^2.27.0",
    "@iconify/json": "^2.2.355",
    "@types/node": "^24.13.3",
    "@unocss/eslint-config": "^66.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.77.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.77.0",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass": "^1.102.0",
    "typescript": "~6.0.0",
    "unocss": "^66.12.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.7"
  },
  "packageManager": "pnpm@12.15.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
